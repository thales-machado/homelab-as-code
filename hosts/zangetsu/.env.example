# zangetsu: copy to .env and fill in. Variables are shared across services
# unless prefixed with the service name (see Conventions in the README).

# --- Global ---
TZ=America/Sao_Paulo
DB_USER=
DB_PASSWORD=
ADMIN_EMAIL=
ADMIN_USER=
ADMIN_PASSWORD=
NODE_HOSTNAME=zangetsu

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Cloudflare ---
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_API_TOKEN=
CF_TUNNEL_TOKEN=
CF_TUNNEL_ID=

# --- Dockflare ---
DOCKFLARE_AGENT_API_KEY=

# --- GitHub ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Firefly III ---
FIREFLY_APP_KEY=
# used by the Homepage widget
FIREFLY_API_TOKEN=

# --- Immich ---
# used by the Homepage widget
IMMICH_API_KEY=

# --- Paperless-ngx ---
PAPERLESS_SECRET_KEY=
PAPERLESS_DBUSER=
PAPERLESS_DBPASS=
PAPERLESS_URL=https://paperless.lan.example.com
PAPERLESS_API_KEY=

# --- Unpoller ---
UP_UNIFI_DEFAULT_URL=
UP_UNIFI_DEFAULT_USER=
UP_UNIFI_DEFAULT_PASS=
UP_UNIFI_DEFAULT_VERIFY_SSL=false
UP_UNIFI_DEFAULT_SAVE_DPI=true
UP_INFLUXDB_DISABLE=true
UP_PROMETHEUS_DISABLE=false

# --- N8N ---
N8N_WEBHOOK_SECRET=
N8N_API_KEY=

# --- Pi-hole ---
PIHOLE_API_KEY=

# --- Restic ---
RESTIC_PASSWORD=

# --- Vaultwarden ---
VAULTWARDEN_ADMIN_TOKEN=
VAULTWARDEN_SMTP_PASSWORD=

# --- UniFi ---
UNIFI_PASSWORD=

# --- QNAP ---
QNAP_USER=
QNAP_PASSWORD=

# --- Healthchecks ---
HEALTHCHECKS_SECRET_KEY=
HEALTHCHECKS_API_KEY=

# --- Docker Hub ---
DOCKERHUB_PAT=

# --- Keepalived ---
KEEPALIVED_VRRP_PASS=

# --- Crowdsec ---
CROWDSEC_BOUNCER_KEY=

# --- Tandoor ---
TANDOOR_API_KEY=

# --- Home Assistant ---
HOMEASSISTANT_TOKEN=

# --- Komodo ---
KOMODO_JWT_SECRET=
KOMODO_WEBHOOK_SECRET=
KOMODO_SERVER_NAME=zangetsu
KOMODO_PERIPHERY_CORE_ADDRESS=ws://komodo-core:9120
KOMODO_PASSKEY=
KOMODO_API_KEY=
KOMODO_API_SECRET=

# --- Watchtower ---
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_HTTP_API_TOKEN=
WATCHTOWER_URAHARA_HTTP_API_TOKEN=

# --- Tailscale ---
# redundant subnet router (zangetsu)
TAILSCALE_AUTH_KEY=
# force the nftables backend on zangetsu (the RPi lacks legacy ip_tables)
TAILSCALE_FIREWALL_MODE=nftables

# --- Evolution API ---
EVOLUTION_DBUSER=
EVOLUTION_DBPASS=
EVOLUTION_API_KEY=
